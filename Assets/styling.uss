.volume-slider {
    width: 360px;
    height: 36px;
}

.volume-slider .unity-base-slider__track,
.volume-slider .unity-slider__track {
    height: 18px;
    border-radius: 12px;
    background-color: rgba(5, 20, 40, 0.95);
    border-width: 3px;
    border-color: rgba(120, 200, 255, 0.85);
}

.volume-slider .unity-base-slider__dragger,
.volume-slider .unity-slider__thumb {
    width: 32px;
    height: 32px;
    border-radius: 16px;

    background-color: rgba(235, 248, 255, 1.0);
    border-width: 3px;
    border-color: rgba(80, 190, 255, 1.0);
}

/* Hover */
.volume-slider .unity-base-slider__dragger:hover,
.volume-slider .unity-slider__thumb:hover {
    background-color: white;
    border-color: rgba(180, 235, 255, 1.0);
}





