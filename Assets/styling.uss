/* ================= START BUTTON ================= */

#startBtn {
    width: 320px;
    height: 90px;

    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: white;
    background-image: resource("Images/startBtn");
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;

    border-width: 0;
    padding: 0;
}

#startBtn:hover { background-image: resource("Images/startBtnHover"); }

