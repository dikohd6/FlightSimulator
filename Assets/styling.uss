.unity-button:hover {
    border-left-color: rgba(255, 244, 0, 255);
    border-right-color: rgba(255, 244, 0, 255);
    border-top-color: rgba(255, 244, 0, 255);
    border-bottom-color: rgba(255, 244, 0, 255);
    border-top-width: 15px;
    border-right-width: 15px;
    border-bottom-width: 15px;
    border-left-width: 15px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}


.big-slider {
    width: 400px;
}

/* override Unity default */
.big-slider.unity-base-slider--horizontal {
    min-height: 32px;
}

/* track */
.big-slider .unity-slider__track {
    height: 200px;
}

/* thumb */
.big-slider .unity-slider__thumb {
    width: 200px;
    height: 300px;
}


